{
  "name": "@michalkvasnicak/pi-memory",
  "version": "0.1.0",
  "private": true,
  "description": "A memory extension for the Pi coding agent.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "test": "node --test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,json,jsonc}": "oxfmt --write"
  },
  "packageManager": "pnpm@10.33.2",
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  }
}
