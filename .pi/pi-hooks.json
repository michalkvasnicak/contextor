{
  "agent_before_settle": {
    "failFast": true,
    "checks": [
      {
        "name": "Format",
        "type": "command",
        "command": "pnpm -C pi-contextor format"
      },
      {
        "name": "Lint",
        "type": "command",
        "command": "pnpm -C pi-contextor lint"
      },
      {
        "name": "Type check",
        "type": "command",
        "command": "pnpm -C pi-contextor check"
      },
      {
        "name": "Rust format",
        "type": "command",
        "inputs": ["contextor/**"],
        "command": "cargo fmt --manifest-path contextor/Cargo.toml -- --check"
      },
      {
        "name": "Rust lint",
        "type": "command",
        "inputs": ["contextor/**"],
        "command": "cargo clippy --locked --manifest-path contextor/Cargo.toml --all-targets -- -D warnings"
      },
      {
        "name": "Rust tests",
        "type": "command",
        "inputs": ["contextor/**"],
        "command": "cargo test --locked --manifest-path contextor/Cargo.toml"
      }
    ]
  }
}
