{
  "name": "@michalkvasnicak/pi-contextor",
  "version": "0.1.0",
  "description": "Attach indexed feature locations to Pi prompts.",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michalkvasnicak/contextor.git",
    "directory": "pi-contextor"
  },
  "files": [
    "extension.ts",
    "skills/"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "cd .. && husky"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,json,jsonc}": "oxfmt --write"
  },
  "packageManager": "pnpm@10.33.2",
  "pi": {
    "extensions": [
      "./extension.ts"
    ],
    "skills": [
      "./skills/contextor"
    ]
  }
}
