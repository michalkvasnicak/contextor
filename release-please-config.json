{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "0dc422a96924e4183f072dfa29ca6ef8585b9b1b",
  "packages": {
    ".": {
      "release-type": "simple",
      "initial-version": "0.1.0",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "toml",
          "path": "contextor/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "contextor/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'contextor')].version"
        },
        {
          "type": "json",
          "path": "pi-contextor/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
